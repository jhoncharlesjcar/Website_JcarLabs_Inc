{
  "name": "jcar-labs-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "content:generate": "node scripts/generate-corporate-content.mjs",
    "predev": "node scripts/generate-corporate-content.mjs",
    "prebuild": "node scripts/generate-corporate-content.mjs",
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "build": "astro check && astro build && node scripts/verify-preservation.mjs",
    "build:vercel": "astro build && node scripts/verify-preservation.mjs",
    "preview": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "legacy": "node server.mjs",
    "test": "node --test tests/server.test.mjs",
    "test:parity": "node scripts/verify-preservation.mjs",
    "test:browser": "node scripts/check-corporate-site.mjs && node scripts/verify-corporate-runtime.mjs",
    "qa": "node scripts/qa-export.mjs",
    "test:interactions": "node scripts/check-interactions.mjs"
  },
  "dependencies": {
    "astro": "7.3.2",
    "parse5": "8.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "typescript": "6.0.3"
  }
}
